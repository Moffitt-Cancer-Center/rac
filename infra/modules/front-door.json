{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "18442333839422967471"
    }
  },
  "parameters": {
    "racEnv": {
      "type": "string",
      "metadata": {
        "description": "Deployment environment: dev | staging | prod"
      }
    },
    "parentDomain": {
      "type": "string",
      "metadata": {
        "description": "Parent DNS domain, e.g., rac.moffitt.org"
      }
    },
    "appGatewayPublicFqdn": {
      "type": "string",
      "metadata": {
        "description": "App Gateway public FQDN"
      }
    },
    "appGatewayPrivateLinkResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "App Gateway Private Link resource ID (empty if using public FQDN origin)"
      }
    },
    "privateLinkLocation": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Azure region for shared private link location (empty to skip private link)"
      }
    },
    "tags": {
      "type": "object",
      "metadata": {
        "description": "Resource tags"
      }
    },
    "deployCustomDomain": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Whether to attach the wildcard + apex custom domains. Defaults to false because Front Door ManagedCertificate does not support wildcard hostnames; the customer-cert path requires the FD profile MI to have Key Vault Secrets User on the source KV (granted in role-assignments). Set true after a real cert exists in KV and the role assignment has propagated (pass 2)."
      }
    },
    "certKvSecretId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of the Key Vault secret holding the TLS cert (e.g. /subscriptions/.../vaults/kv-rac-bootstrap-001/secrets/rac-dev-tls). Required when deployCustomDomain=true. Versionless — FD pins useLatestVersion=true so a re-issued cert is picked up automatically."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Cdn/profiles",
      "apiVersion": "2023-05-01",
      "name": "[format('afd-rac-{0}', parameters('racEnv'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Premium_AzureFrontDoor"
      },
      "identity": {
        "type": "SystemAssigned"
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('afd-rac-{0}', parameters('racEnv')), format('afd-endpoint-{0}', parameters('racEnv')))]",
      "location": "global",
      "properties": {
        "enabledState": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv')))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('afd-rac-{0}', parameters('racEnv')), format('og-appgw-{0}', parameters('racEnv')))]",
      "properties": {
        "loadBalancingSettings": {
          "sampleSize": 4,
          "successfulSamplesRequired": 3,
          "additionalLatencyInMilliseconds": 50
        },
        "sessionAffinityState": "Disabled",
        "trafficRestorationTimeToHealedOrNewEndpointsInMinutes": 10
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv')))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups/origins",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', format('afd-rac-{0}', parameters('racEnv')), format('og-appgw-{0}', parameters('racEnv')), format('origin-appgw-{0}', parameters('racEnv')))]",
      "properties": {
        "hostName": "[parameters('appGatewayPublicFqdn')]",
        "httpPort": 80,
        "httpsPort": 443,
        "priority": 1,
        "weight": 1000,
        "enabledState": "Enabled",
        "sharedPrivateLinkResource": "[if(and(not(empty(parameters('appGatewayPrivateLinkResourceId'))), not(empty(parameters('privateLinkLocation')))), createObject('privateLink', createObject('id', parameters('appGatewayPrivateLinkResourceId')), 'groupId', 'appgw', 'privateLinkLocation', parameters('privateLinkLocation')), null())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/originGroups', format('afd-rac-{0}', parameters('racEnv')), format('og-appgw-{0}', parameters('racEnv')))]"
      ]
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints/routes",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', format('afd-rac-{0}', parameters('racEnv')), format('afd-endpoint-{0}', parameters('racEnv')), format('route-wildcard-{0}', parameters('racEnv')))]",
      "properties": {
        "originGroup": {
          "id": "[resourceId('Microsoft.Cdn/profiles/originGroups', format('afd-rac-{0}', parameters('racEnv')), format('og-appgw-{0}', parameters('racEnv')))]"
        },
        "supportedProtocols": [
          "Https"
        ],
        "patternsToMatch": [
          "/*"
        ],
        "forwardingProtocol": "HttpsOnly",
        "linkToDefaultDomain": "Enabled",
        "httpsRedirect": "Enabled",
        "enabledState": "Enabled",
        "customDomains": "[if(parameters('deployCustomDomain'), createArray(createObject('id', resourceId('Microsoft.Cdn/profiles/customDomains', format('afd-rac-{0}', parameters('racEnv')), format('domain-wildcard-{0}', parameters('racEnv')))), createObject('id', resourceId('Microsoft.Cdn/profiles/customDomains', format('afd-rac-{0}', parameters('racEnv')), format('domain-apex-{0}', parameters('racEnv'))))), createArray())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/customDomains', format('afd-rac-{0}', parameters('racEnv')), format('domain-apex-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Cdn/profiles/customDomains', format('afd-rac-{0}', parameters('racEnv')), format('domain-wildcard-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', format('afd-rac-{0}', parameters('racEnv')), format('afd-endpoint-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups/origins', format('afd-rac-{0}', parameters('racEnv')), format('og-appgw-{0}', parameters('racEnv')), format('origin-appgw-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups', format('afd-rac-{0}', parameters('racEnv')), format('og-appgw-{0}', parameters('racEnv')))]"
      ]
    },
    {
      "condition": "[parameters('deployCustomDomain')]",
      "type": "Microsoft.Cdn/profiles/secrets",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('afd-rac-{0}', parameters('racEnv')), format('cert-rac-{0}', parameters('racEnv')))]",
      "properties": {
        "parameters": {
          "type": "CustomerCertificate",
          "useLatestVersion": true,
          "secretSource": {
            "id": "[parameters('certKvSecretId')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv')))]"
      ]
    },
    {
      "condition": "[parameters('deployCustomDomain')]",
      "type": "Microsoft.Cdn/profiles/customDomains",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('afd-rac-{0}', parameters('racEnv')), format('domain-wildcard-{0}', parameters('racEnv')))]",
      "properties": {
        "hostName": "[format('*.{0}', parameters('parentDomain'))]",
        "tlsSettings": {
          "certificateType": "CustomerCertificate",
          "minimumTlsVersion": "TLS12",
          "secret": {
            "id": "[resourceId('Microsoft.Cdn/profiles/secrets', format('afd-rac-{0}', parameters('racEnv')), format('cert-rac-{0}', parameters('racEnv')))]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/secrets', format('afd-rac-{0}', parameters('racEnv')), format('cert-rac-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv')))]"
      ]
    },
    {
      "condition": "[parameters('deployCustomDomain')]",
      "type": "Microsoft.Cdn/profiles/customDomains",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('afd-rac-{0}', parameters('racEnv')), format('domain-apex-{0}', parameters('racEnv')))]",
      "properties": {
        "hostName": "[parameters('parentDomain')]",
        "tlsSettings": {
          "certificateType": "CustomerCertificate",
          "minimumTlsVersion": "TLS12",
          "secret": {
            "id": "[resourceId('Microsoft.Cdn/profiles/secrets', format('afd-rac-{0}', parameters('racEnv')), format('cert-rac-{0}', parameters('racEnv')))]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/secrets', format('afd-rac-{0}', parameters('racEnv')), format('cert-rac-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv')))]"
      ]
    },
    {
      "type": "Microsoft.Network/FrontDoorWebApplicationFirewallPolicies",
      "apiVersion": "2022-05-01",
      "name": "[format('wafrac{0}', parameters('racEnv'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Premium_AzureFrontDoor"
      },
      "properties": {
        "policySettings": {
          "enabledState": "Enabled",
          "mode": "Prevention"
        },
        "managedRules": {
          "managedRuleSets": [
            {
              "ruleSetType": "Microsoft_DefaultRuleSet",
              "ruleSetVersion": "1.1",
              "ruleSetAction": "Block"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/securityPolicies",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', format('afd-rac-{0}', parameters('racEnv')), format('secpol-{0}', parameters('racEnv')))]",
      "properties": {
        "parameters": {
          "type": "WebApplicationFirewall",
          "wafPolicy": {
            "id": "[resourceId('Microsoft.Network/FrontDoorWebApplicationFirewallPolicies', format('wafrac{0}', parameters('racEnv')))]"
          },
          "associations": [
            {
              "domains": [
                {
                  "id": "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', format('afd-rac-{0}', parameters('racEnv')), format('afd-endpoint-{0}', parameters('racEnv')))]"
                }
              ],
              "patternsToMatch": [
                "/*"
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', format('afd-rac-{0}', parameters('racEnv')), format('afd-endpoint-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv')))]",
        "[resourceId('Microsoft.Network/FrontDoorWebApplicationFirewallPolicies', format('wafrac{0}', parameters('racEnv')))]"
      ]
    }
  ],
  "outputs": {
    "frontDoorProfileId": {
      "type": "string",
      "metadata": {
        "description": "Front Door Profile resource ID"
      },
      "value": "[resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv')))]"
    },
    "frontDoorEndpointHostname": {
      "type": "string",
      "metadata": {
        "description": "Front Door endpoint hostname"
      },
      "value": "[reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints', format('afd-rac-{0}', parameters('racEnv')), format('afd-endpoint-{0}', parameters('racEnv'))), '2023-05-01').hostName]"
    },
    "wafPolicyId": {
      "type": "string",
      "metadata": {
        "description": "WAF Policy resource ID"
      },
      "value": "[resourceId('Microsoft.Network/FrontDoorWebApplicationFirewallPolicies', format('wafrac{0}', parameters('racEnv')))]"
    },
    "frontDoorMiPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Front Door profile system-assigned MI principal ID (for KV role assignments)"
      },
      "value": "[reference(resourceId('Microsoft.Cdn/profiles', format('afd-rac-{0}', parameters('racEnv'))), '2023-05-01', 'full').identity.principalId]"
    },
    "wildcardDomainValidationToken": {
      "type": "string",
      "metadata": {
        "description": "Wildcard custom domain validation token (TXT value to add at _dnsauth.<wildcard>) — empty when deployCustomDomain=false"
      },
      "value": "[coalesce(tryGet(if(parameters('deployCustomDomain'), reference(resourceId('Microsoft.Cdn/profiles/customDomains', format('afd-rac-{0}', parameters('racEnv')), format('domain-wildcard-{0}', parameters('racEnv'))), '2023-05-01', 'full'), null()), 'properties', 'validationProperties', 'validationToken'), '')]"
    },
    "apexDomainValidationToken": {
      "type": "string",
      "metadata": {
        "description": "Apex custom domain validation token (TXT value to add at _dnsauth.<apex>) — empty when deployCustomDomain=false"
      },
      "value": "[coalesce(tryGet(if(parameters('deployCustomDomain'), reference(resourceId('Microsoft.Cdn/profiles/customDomains', format('afd-rac-{0}', parameters('racEnv')), format('domain-apex-{0}', parameters('racEnv'))), '2023-05-01', 'full'), null()), 'properties', 'validationProperties', 'validationToken'), '')]"
    }
  }
}